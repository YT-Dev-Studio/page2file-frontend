# Never put PAGE2FILE_WEB_HMAC_SECRET in this file.
# Add it with: npx wrangler secret put PAGE2FILE_WEB_HMAC_SECRET

# Support feedback Telegram delivery. Keep every value server-only.
# Add the bot token with: npx wrangler secret put TELEGRAM_BOT_TOKEN
# TELEGRAM_BOT_TOKEN=
# Full Bot API chat ID (-100...) or the positive ID from a Telegram Web /c/... link.
TELEGRAM_GROUP_ID=
TELEGRAM_TOPIC_ID=
