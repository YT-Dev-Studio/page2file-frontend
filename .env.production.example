NEXT_PUBLIC_GA_MEASUREMENT_ID=G-7MVCPE7QMR
NEXT_PUBLIC_CHROME_EXTENSION_URL=
NEXT_PUBLIC_PAGE2PDF_GPT_URL=https://chatgpt.com/g/g-6a6911cbe52c819182c9cc66d9e68d01-web2file-webpage-to-pdf-converter
